<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Copyright>2026 Malte Peters</Copyright>
    <Authors>Malte Peters</Authors>
    <Company>Malte Peters</Company>
    <Description>Fluent-style wrapper for TheGamesDB API with dependency injection support.</Description>
    <PackageProjectUrl>https://github.com/nfMalde/TheGamesDBApiWrapper</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nfMalde/TheGamesDBApiWrapper</RepositoryUrl>
    <RepositoryType>GIT</RepositoryType>
    <PackageTags>TheGamesDB, API, GamesDB, The Games DB API</PackageTags>
	  <PackageReleaseNotes>
		  <![CDATA[
- **Fixes**:
  - `GameUpdateValueConverter` now reads a single JSON object for a game update `value`. TheGamesDB returns one for some edit types, and the converter previously threw — which aborted the whole paginated `Games/Updates` walk. Because the caller's last-edit cursor only advances on a completed walk, every subsequent run replayed the same pages and failed on the same record, so an import could never get past it.
  - `GameUpdateValueConverter` also accepts boolean values.
  - The exception for a genuinely unreadable value now names the token type and byte offset instead of the bare "Unexpected JSON token type.", which carried no way to identify the offending record.
]]>
	  </PackageReleaseNotes>

	  <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
	  <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.4" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

</Project>
